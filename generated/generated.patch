+		subMenu = std_separator
+
+		# Digital outputs
+		subMenu = outputsDialog,			"Outputs"
+		subMenu = fanSettings,				"Cooling Fans"
+		subMenu = fan1PwmCurveDialog,		"Fan 1 PWM Curve", 0, { fan1PwmEnabled }
+		subMenu = fan2PwmCurveDialog,		"Fan 2 PWM Curve", 0, { fan2PwmEnabled }
+		subMenu = acSettings,				"Air Conditioning"
+
+	menu = "Fuel"
+		# Air mass model
+		subMenu = veTableDialog,			"VE", 0, {isInjectionEnabled == 1}
+		subMenu = veTableMap,    "VE 3D view", 0, {isInjectionEnabled}
+		subMenu = secondVeTableDialog,		"Second VE Table", 0, {isInjectionEnabled == 1}
+		
+
+		# basic
+		groupMenu = "Injector Setup"
+		groupChildMenu = injectorConfig,			"Injection configuration"
+		groupChildMenu = injectionSettings,		"Injection hardware", {isInjectionEnabled == 1}, { uiMode == 0 || uiMode == 1 }
+		groupChildMenu = injectorsDeadTime, "Injector deadtime (BatV vs fuel pressure)", {isInjectionEnabled}
+		groupChildMenu = injPhaseTableTbl,			"Injection Timing", 0, {isInjectionEnabled == 1}
+		groupChildMenu = cylinderBankSelect,		"Cylinder bank selection", {isInjectionEnabled == 1}, { uiMode == 0 || uiMode == 1 }
